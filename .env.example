# --- Tetherless configuration (copy to .env; .env is git-ignored) ---

# The PRIVATE Git repo used as the message bus (SSH or HTTPS with a token).
# Only you should have push access. The agent pulls tasks and pushes results here.
BUS_REPO=git@github.com:YOUR_USERNAME/tetherless-bus.git

# How often (seconds) the agent checks the bus. The plan sets a minimum.
POLL_INTERVAL=30

# A name for this agent (shows up in results and the audit log).
AGENT_ID=home-box

# Signed license key (Trial or Pro). Leave empty to run on Free.
LICENSE_KEY=

# Comma-separated allow-list of shell commands the `command` runner may invoke.
# Do NOT add interpreters (node, python, sh): they can run any code.
COMMAND_ALLOWLIST=echo,ls,df,uptime

# --- HTTP runner controls (both lists are enforced locally) ---

# Hosts the http runner may call. Anything else is refused.
HTTP_ALLOW_HOSTS=graph.facebook.com

# Env var names the http runner may send as tokens. Anything else is refused.
HTTP_TOKEN_ENVS=FB_ACCESS_TOKEN

# --- Secrets for runners (optional; only what you use) ---

# Facebook / Meta Marketing API (official API, not scraping)
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=

# Add your own API tokens here and list their names in HTTP_TOKEN_ENVS.
